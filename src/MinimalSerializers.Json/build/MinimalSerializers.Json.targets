<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    CRITICAL: Keep ALL path property VALUES on a single line with no leading/trailing whitespace.
    Formatters that pretty-print XML will insert newlines and break MSBuild paths (MSB4062).
    Do not gate UsingTask on Exists(task DLL). Clean CI builds the task before invocation.
  -->
  <PropertyGroup>
    <_MinimalJson_PackagedTaskAssembly>$(MSBuildThisFileDirectory)../tasks/net10.0/MinimalSerializers.Json.Tasks.dll</_MinimalJson_PackagedTaskAssembly>
    <_MinimalJson_RepoTaskCandidate>$(MSBuildThisFileDirectory)../../MinimalSerializers.Json.Tasks/bin/$(Configuration)/net10.0/MinimalSerializers.Json.Tasks.dll</_MinimalJson_RepoTaskCandidate>
    <_MinimalJson_RepoTaskCandidate2>$(MSBuildThisFileDirectory)../../MinimalSerializers.Json.Tasks/bin/Debug/net10.0/MinimalSerializers.Json.Tasks.dll</_MinimalJson_RepoTaskCandidate2>
    <_MinimalJson_TasksProject>$(MSBuildThisFileDirectory)../../MinimalSerializers.Json.Tasks/MinimalSerializers.Json.Tasks.csproj</_MinimalJson_TasksProject>

    <MinimalJson_TaskAssembly Condition="'$(MinimalJson_TaskAssembly)' == '' and Exists('$(_MinimalJson_PackagedTaskAssembly)')">$(_MinimalJson_PackagedTaskAssembly)</MinimalJson_TaskAssembly>
    <MinimalJson_TaskAssembly Condition="'$(MinimalJson_TaskAssembly)' == '' and Exists('$(_MinimalJson_RepoTaskCandidate)')">$(_MinimalJson_RepoTaskCandidate)</MinimalJson_TaskAssembly>
    <MinimalJson_TaskAssembly Condition="'$(MinimalJson_TaskAssembly)' == '' and Exists('$(_MinimalJson_RepoTaskCandidate2)')">$(_MinimalJson_RepoTaskCandidate2)</MinimalJson_TaskAssembly>
    <MinimalJson_TaskAssembly Condition="'$(MinimalJson_TaskAssembly)' == '' and Exists('$(_MinimalJson_TasksProject)')">$(_MinimalJson_RepoTaskCandidate)</MinimalJson_TaskAssembly>
    <MinimalJson_TaskAssembly Condition="'$(MinimalJson_TaskAssembly)' == ''">$(_MinimalJson_PackagedTaskAssembly)</MinimalJson_TaskAssembly>

    <_MinimalJson_BaseOut Condition="'$(IntermediateOutputPath)' != ''">$(IntermediateOutputPath)</_MinimalJson_BaseOut>
    <_MinimalJson_BaseOut Condition="'$(_MinimalJson_BaseOut)' == ''">$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/</_MinimalJson_BaseOut>
    <_MinimalJson_BaseOut Condition="'$(_MinimalJson_BaseOut)' == ''">obj/$(Configuration)/</_MinimalJson_BaseOut>
    <MinimalJson_GeneratedDir>$(_MinimalJson_BaseOut)minimaljson/</MinimalJson_GeneratedDir>
    <MinimalJson_StampFile>$(MinimalJson_GeneratedDir)stamp.minimaljson</MinimalJson_StampFile>
    <MinimalJson_InputsFile>$(MinimalJson_GeneratedDir)inputs.minimaljson</MinimalJson_InputsFile>
  </PropertyGroup>

  <!-- Visual Studio fast up-to-date check: missing stamp means generation still needs to run. -->
  <ItemGroup Condition="'$(MinimalJsonSerializerEnabled)' == 'true'">
    <UpToDateCheckOutput Include="$(MinimalJson_StampFile)" />
  </ItemGroup>

  <UsingTask TaskName="MinimalSerializers.Json.Tasks.GenerateMinimalJsonSerializerContexts" AssemblyFile="$(MinimalJson_TaskAssembly)" Condition="'$(MinimalJson_TaskAssembly)' != ''" />

  <Target Name="MinimalJson_EnsureTasksBuilt" BeforeTargets="MinimalJson_GenerateContexts" Condition="'$(MinimalJsonSerializerEnabled)' == 'true'">
    <MSBuild Projects="$(_MinimalJson_TasksProject)" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net10.0;NoBuild=false" Condition="Exists('$(_MinimalJson_TasksProject)') and !Exists('$(MinimalJson_TaskAssembly)') and '$(NoBuild)' != 'true'" />
    <PropertyGroup>
      <MinimalJson_TaskAssembly Condition="Exists('$(_MinimalJson_PackagedTaskAssembly)')">$(_MinimalJson_PackagedTaskAssembly)</MinimalJson_TaskAssembly>
      <MinimalJson_TaskAssembly Condition="Exists('$(_MinimalJson_RepoTaskCandidate)')">$(_MinimalJson_RepoTaskCandidate)</MinimalJson_TaskAssembly>
      <MinimalJson_TaskAssembly Condition="(!Exists('$(MinimalJson_TaskAssembly)') or '$(MinimalJson_TaskAssembly)' == '') and Exists('$(_MinimalJson_RepoTaskCandidate2)')">$(_MinimalJson_RepoTaskCandidate2)</MinimalJson_TaskAssembly>
    </PropertyGroup>
    <Error Text="MinimalSerializers.Json task assembly was not found at '$(MinimalJson_TaskAssembly)'. Build MinimalSerializers.Json.Tasks or restore the NuGet package." Condition="!Exists('$(MinimalJson_TaskAssembly)')" Code="MSJ0007" />
  </Target>

  <!-- Must run with no Inputs/Outputs so a missing *.MinimalJson.g.cs listed in the
       stamp is detected before MinimalJson_GenerateContexts can skip. Do not delete
       the stamp merely because the directory has no generated files: projects with
       no [MinimalJsonSerializerContext] (including buildTransitive dependents)
       write an empty stamp and must stay up-to-date. -->
  <Target Name="MinimalJson_InvalidateStaleStamp" Condition="'$(MinimalJsonSerializerEnabled)' == 'true'">
    <ItemGroup>
      <_MinimalJson_StampLines Remove="@(_MinimalJson_StampLines)" />
      <_MinimalJson_StampGenerated Remove="@(_MinimalJson_StampGenerated)" />
      <_MinimalJson_MissingGenerated Remove="@(_MinimalJson_MissingGenerated)" />
    </ItemGroup>
    <ReadLinesFromFile File="$(MinimalJson_StampFile)" Condition="Exists('$(MinimalJson_StampFile)')">
      <Output TaskParameter="Lines" ItemName="_MinimalJson_StampLines" />
    </ReadLinesFromFile>
    <ItemGroup>
      <!-- Ignore non-path lines (legacy UTC timestamps). Empty stamps are valid. -->
      <_MinimalJson_StampGenerated Include="@(_MinimalJson_StampLines)" Condition="$([System.String]::Copy('%(Identity)').EndsWith('.MinimalJson.g.cs'))" />
      <_MinimalJson_MissingGenerated Include="@(_MinimalJson_StampGenerated)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="$(MinimalJson_StampFile)" Condition="'@(_MinimalJson_MissingGenerated)' != ''" />
  </Target>

  <!-- @(Compile)/@(ReferencePath) timestamps do not change when a globbed file or
       package reference is removed/replaced with an older DLL, and MinimalJsonEmit*
       / LangVersion can change with no file touch. Fingerprint those identities and
       option values (write-if-different) so GenerateContexts cannot skip with stale roots. -->
  <Target Name="MinimalJson_WriteInputFingerprint" Condition="'$(MinimalJsonSerializerEnabled)' == 'true'">
    <MakeDir Directories="$(MinimalJson_GeneratedDir)" />
    <ItemGroup>
      <_MinimalJson_CompileForFingerprint Remove="@(_MinimalJson_CompileForFingerprint)" />
      <_MinimalJson_FingerprintLines Remove="@(_MinimalJson_FingerprintLines)" />
      <_MinimalJson_CompileForFingerprint Include="@(Compile)" Condition="!$([System.String]::Copy('%(Identity)').EndsWith('.MinimalJson.g.cs'))" />
      <_MinimalJson_FingerprintLines Include="LangVersion=$(LangVersion)" />
      <_MinimalJson_FingerprintLines Include="EmitArrays=$(MinimalJsonEmitArrays)" />
      <_MinimalJson_FingerprintLines Include="EmitList=$(MinimalJsonEmitList)" />
      <_MinimalJson_FingerprintLines Include="EmitDeclaredCollections=$(MinimalJsonEmitDeclaredCollections)" />
      <_MinimalJson_FingerprintLines Include="EmitDictionaries=$(MinimalJsonEmitDictionaries)" />
      <_MinimalJson_FingerprintLines Include="WarnOpenGenerics=$(MinimalJsonWarnOpenGenerics)" />
      <_MinimalJson_FingerprintLines Include="Task=$(MinimalJson_TaskAssembly)" />
      <_MinimalJson_FingerprintLines Include="@(_MinimalJson_CompileForFingerprint->'Compile=%(FullPath)')" />
      <_MinimalJson_FingerprintLines Include="@(ReferencePath->'Ref=%(FullPath)')" />
      <_MinimalJson_FingerprintLines Include="@(ReferencePathWithRefAssemblies->'RefAsm=%(FullPath)')" />
      <_MinimalJson_FingerprintLines Include="@(RuntimeCopyLocalItems->'CopyLocal=%(FullPath)')" Condition="'@(RuntimeCopyLocalItems)' != ''" />
    </ItemGroup>
    <WriteLinesToFile File="$(MinimalJson_InputsFile)" Lines="@(_MinimalJson_FingerprintLines)" Overwrite="true" WriteOnlyWhenDifferent="true" Encoding="UTF-8" />
  </Target>

  <!-- Outputs must be the stamp file only. MSBuild does not expand ** globs in
       Target Outputs, so listing $(MinimalJson_GeneratedDir)**\*.MinimalJson.g.cs
       is treated as a literal missing path and the target runs every build.
       Generated .cs files also cannot be Outputs: WriteIfChanged leaves their
       timestamps older than Inputs, which keeps the target permanently dirty. -->
  <Target Name="MinimalJson_GenerateContexts"
          BeforeTargets="BeforeCompile;CoreCompile"
          DependsOnTargets="ResolveAssemblyReferences;MinimalJson_EnsureTasksBuilt;MinimalJson_InvalidateStaleStamp;MinimalJson_WriteInputFingerprint"
          Condition="'$(MinimalJsonSerializerEnabled)' == 'true' and ('$(DesignTimeBuild)' != 'true' or '$(MinimalJson_EnableDesignTime)' == 'true') and '$(MinimalJson_TaskAssembly)' != ''"
          Inputs="@(Compile);@(ReferencePath);@(ReferencePathWithRefAssemblies);@(RuntimeCopyLocalItems);$(MSBuildProjectFullPath);$(MinimalJson_TaskAssembly);$(MinimalJson_InputsFile)"
          Outputs="$(MinimalJson_StampFile)">
    <MakeDir Directories="$(MinimalJson_GeneratedDir)" />
    <ItemGroup>
      <_MinimalJson_References Remove="@(_MinimalJson_References)" />
      <_MinimalJson_References Include="@(ReferencePath)" />
      <_MinimalJson_References Include="@(ReferencePathWithRefAssemblies)" />
      <_MinimalJson_References Include="@(RuntimeCopyLocalItems)" Condition="'@(RuntimeCopyLocalItems)' != ''" />
    </ItemGroup>
    <GenerateMinimalJsonSerializerContexts CompileFiles="@(Compile)" ReferencePaths="@(_MinimalJson_References)" OutputDirectory="$(MinimalJson_GeneratedDir)" LangVersion="$(LangVersion)" IncludeArrays="$(MinimalJsonEmitArrays)" IncludeList="$(MinimalJsonEmitList)" IncludeDeclaredCollectionInterfaces="$(MinimalJsonEmitDeclaredCollections)" IncludeDictionaries="$(MinimalJsonEmitDictionaries)" WarnOpenGenerics="$(MinimalJsonWarnOpenGenerics)">
      <Output TaskParameter="GeneratedFiles" ItemName="MinimalJsonGenerated" />
    </GenerateMinimalJsonSerializerContexts>
    <ItemGroup>
      <FileWrites Include="@(MinimalJsonGenerated)" />
      <FileWrites Include="$(MinimalJson_StampFile)" />
    </ItemGroup>
  </Target>

  <Target Name="MinimalJson_IncludeGenerated" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="MinimalJson_GenerateContexts" Condition="'$(MinimalJsonSerializerEnabled)' == 'true'">
    <ItemGroup>
      <Compile Remove="$(MinimalJson_GeneratedDir)**\*.MinimalJson.g.cs" />
      <Compile Include="$(MinimalJson_GeneratedDir)**\*.MinimalJson.g.cs" Condition="Exists('$(MinimalJson_GeneratedDir)')" KeepDuplicates="false" />
      <!-- Must always record FileWrites. If GenerateContexts is skipped, IncrementalClean
           would otherwise delete *.MinimalJson.g.cs as stale intermediates. -->
      <FileWrites Include="$(MinimalJson_GeneratedDir)**\*.MinimalJson.g.cs" />
      <FileWrites Include="$(MinimalJson_StampFile)" />
      <FileWrites Include="$(MinimalJson_InputsFile)" />
    </ItemGroup>
  </Target>
</Project>
