<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <!-- IMPORTANT: Keep property values on one line. Leading/trailing whitespace becomes part of the path. -->
    <MinimalJson_TaskAssembly Condition="'$(MinimalJson_TaskAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)../tasks/net8.0/MinimalSerializers.Json.Tasks.dll')">$(MSBuildThisFileDirectory)../tasks/net8.0/MinimalSerializers.Json.Tasks.dll</MinimalJson_TaskAssembly>
    <_MinimalJson_RepoTaskCandidate>$(MSBuildThisFileDirectory)../../MinimalSerializers.Json.Tasks/bin/$(Configuration)/net8.0/MinimalSerializers.Json.Tasks.dll</_MinimalJson_RepoTaskCandidate>
    <_MinimalJson_RepoTaskCandidate2>$(MSBuildThisFileDirectory)../../MinimalSerializers.Json.Tasks/bin/Debug/net8.0/MinimalSerializers.Json.Tasks.dll</_MinimalJson_RepoTaskCandidate2>
    <MinimalJson_TaskAssembly Condition="'$(MinimalJson_TaskAssembly)' == '' and Exists('$(_MinimalJson_RepoTaskCandidate)')">$(_MinimalJson_RepoTaskCandidate)</MinimalJson_TaskAssembly>
    <MinimalJson_TaskAssembly Condition="'$(MinimalJson_TaskAssembly)' == '' and Exists('$(_MinimalJson_RepoTaskCandidate2)')">$(_MinimalJson_RepoTaskCandidate2)</MinimalJson_TaskAssembly>
    <_MinimalJson_BaseOut Condition="'$(IntermediateOutputPath)' != ''">$(IntermediateOutputPath)</_MinimalJson_BaseOut>
    <_MinimalJson_BaseOut Condition="'$(_MinimalJson_BaseOut)' == ''">$(BaseIntermediateOutputPath)$(Configuration)/$(TargetFramework)/</_MinimalJson_BaseOut>
    <_MinimalJson_BaseOut Condition="'$(_MinimalJson_BaseOut)' == ''">obj/$(Configuration)/</_MinimalJson_BaseOut>
    <MinimalJson_GeneratedDir>$(_MinimalJson_BaseOut)minimaljson/</MinimalJson_GeneratedDir>
  </PropertyGroup>

  <UsingTask TaskName="MinimalSerializers.Json.Tasks.GenerateMinimalJsonSerializerContexts" AssemblyFile="$(MinimalJson_TaskAssembly)" Condition="'$(MinimalJson_TaskAssembly)' != '' and Exists('$(MinimalJson_TaskAssembly)')" />

  <Target Name="MinimalJson_EnsureTasksBuilt" BeforeTargets="MinimalJson_GenerateContexts" Condition="'$(MinimalJsonSerializerEnabled)' == 'true'">
    <PropertyGroup>
      <_MinimalJson_TasksProject>$(MSBuildThisFileDirectory)../../MinimalSerializers.Json.Tasks/MinimalSerializers.Json.Tasks.csproj</_MinimalJson_TasksProject>
    </PropertyGroup>
    <MSBuild Projects="$(_MinimalJson_TasksProject)" Targets="Build" Properties="Configuration=$(Configuration);TargetFramework=net8.0" Condition="Exists('$(_MinimalJson_TasksProject)') and ('$(MinimalJson_TaskAssembly)' == '' or !Exists('$(MinimalJson_TaskAssembly)'))" />
    <PropertyGroup>
      <MinimalJson_TaskAssembly Condition="Exists('$(_MinimalJson_RepoTaskCandidate)')">$(_MinimalJson_RepoTaskCandidate)</MinimalJson_TaskAssembly>
      <MinimalJson_TaskAssembly Condition="('$(MinimalJson_TaskAssembly)' == '' or !Exists('$(MinimalJson_TaskAssembly)')) and Exists('$(_MinimalJson_RepoTaskCandidate2)')">$(_MinimalJson_RepoTaskCandidate2)</MinimalJson_TaskAssembly>
    </PropertyGroup>
  </Target>

  <Target Name="MinimalJson_GenerateContexts" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="ResolveAssemblyReferences;MinimalJson_EnsureTasksBuilt" Condition="'$(MinimalJsonSerializerEnabled)' == 'true' and ('$(DesignTimeBuild)' != 'true' or '$(MinimalJson_EnableDesignTime)' == 'true') and '$(MinimalJson_TaskAssembly)' != '' and Exists('$(MinimalJson_TaskAssembly)')" Inputs="@(Compile);@(ReferencePath);$(MSBuildProjectFullPath)" Outputs="$(MinimalJson_GeneratedDir)stamp.minimaljson">
    <MakeDir Directories="$(MinimalJson_GeneratedDir)" />
    <!-- If a previous run left a stamp without generated sources, force regeneration. -->
    <ItemGroup>
      <_MinimalJson_GeneratedExisting Include="$(MinimalJson_GeneratedDir)**\*.MinimalJson.g.cs" Condition="Exists('$(MinimalJson_GeneratedDir)')" />
    </ItemGroup>
    <Delete Files="$(MinimalJson_GeneratedDir)stamp.minimaljson" Condition="Exists('$(MinimalJson_GeneratedDir)stamp.minimaljson') and '@(_MinimalJson_GeneratedExisting)' == ''" />
    <ItemGroup>
      <_MinimalJson_References Include="@(ReferencePath)" />
      <_MinimalJson_References Include="@(ReferencePathWithRefAssemblies)" />
      <_MinimalJson_References Include="@(RuntimeCopyLocalItems)" Condition="'@(RuntimeCopyLocalItems)' != ''" />
    </ItemGroup>
    <GenerateMinimalJsonSerializerContexts CompileFiles="@(Compile)" ReferencePaths="@(_MinimalJson_References)" OutputDirectory="$(MinimalJson_GeneratedDir)" LangVersion="$(LangVersion)" IncludeArrays="$(MinimalJsonEmitArrays)" IncludeList="$(MinimalJsonEmitList)" IncludeDeclaredCollectionInterfaces="$(MinimalJsonEmitDeclaredCollections)" IncludeDictionaries="$(MinimalJsonEmitDictionaries)">
      <Output TaskParameter="GeneratedFiles" ItemName="MinimalJsonGenerated" />
    </GenerateMinimalJsonSerializerContexts>
    <ItemGroup>
      <FileWrites Include="@(MinimalJsonGenerated)" />
      <FileWrites Include="$(MinimalJson_GeneratedDir)stamp.minimaljson" />
    </ItemGroup>
  </Target>

  <!-- Always include generated files in Compile, even when generation target is skipped as up-to-date. -->
  <Target Name="MinimalJson_IncludeGenerated" BeforeTargets="BeforeCompile;CoreCompile" DependsOnTargets="MinimalJson_GenerateContexts" Condition="'$(MinimalJsonSerializerEnabled)' == 'true'">
    <ItemGroup>
      <_MinimalJson_GeneratedExisting Include="$(MinimalJson_GeneratedDir)**\*.MinimalJson.g.cs" Condition="Exists('$(MinimalJson_GeneratedDir)')" />
    </ItemGroup>
    <!-- If stamp exists without sources, invalidate stamp so next build regenerates. -->
    <Delete Files="$(MinimalJson_GeneratedDir)stamp.minimaljson" Condition="Exists('$(MinimalJson_GeneratedDir)stamp.minimaljson') and '@(_MinimalJson_GeneratedExisting)' == ''" />
    <ItemGroup>
      <Compile Include="$(MinimalJson_GeneratedDir)**\*.MinimalJson.g.cs" Condition="Exists('$(MinimalJson_GeneratedDir)')" KeepDuplicates="false" />
    </ItemGroup>
  </Target>
</Project>

