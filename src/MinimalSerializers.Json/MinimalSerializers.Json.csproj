<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>true</IsPackable>
    <PackageId>MinimalSerializers.Json</PackageId>
    <Description>Auto-generate System.Text.Json JsonSerializable roots from DataContract graphs
      before CoreCompile so the built-in STJ source generator can emit serializers in a single
      build.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;NU5100</NoWarn>
    <RootNamespace>MinimalSerializers.Json</RootNamespace>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <BuildTaskProject>
      $(MSBuildThisFileDirectory)..\MinimalSerializers.Json.Tasks\MinimalSerializers.Json.Tasks.csproj</BuildTaskProject>
    <BuildTaskOutputDir>
      $(MSBuildThisFileDirectory)..\MinimalSerializers.Json.Tasks\bin\$(Configuration)\net8.0\</BuildTaskOutputDir>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
  </PropertyGroup>

  <ItemGroup>
    <None Include="build\MinimalSerializers.Json.props" Pack="true"
      PackagePath="buildTransitive/MinimalSerializers.Json.props" />
    <None Include="build\MinimalSerializers.Json.targets" Pack="true"
      PackagePath="buildTransitive/MinimalSerializers.Json.targets" />
    <None Include="build\MinimalSerializers.Json.props" Pack="true"
      PackagePath="build/MinimalSerializers.Json.props" />
    <None Include="build\MinimalSerializers.Json.targets" Pack="true"
      PackagePath="build/MinimalSerializers.Json.targets" />
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Target Name="MinimalJson_IncludeTaskAssets" BeforeTargets="_GetPackageFiles"
    Condition="'$(IsPackable)' == 'true'">
    <!-- Build task assets only when missing. Nested Build under pack NoBuild hits NETSDK1085. -->
    <MSBuild
      Projects="$(BuildTaskProject)"
      Targets="Restore;Build"
      Properties="Configuration=$(Configuration);TargetFramework=net8.0;NoBuild=false;BuildProjectReferences=true"
      Condition="!Exists('$(BuildTaskOutputDir)MinimalSerializers.Json.Tasks.dll') and '$(NoBuild)' != 'true'" />
    <Error
      Code="MSJ0008"
      Text="MinimalSerializers.Json task assets were not found under '$(BuildTaskOutputDir)'. Build MinimalSerializers.Json.Tasks (net8.0) before packing, or pack without NoBuild."
      Condition="!Exists('$(BuildTaskOutputDir)MinimalSerializers.Json.Tasks.dll')" />
    <ItemGroup>
      <_PackageFiles Include="$(BuildTaskOutputDir)MinimalSerializers.Json.Tasks.dll">
        <PackagePath>tasks/net8.0/</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="$(BuildTaskOutputDir)MinimalSerializers.Json.Discovery.dll">
        <PackagePath>tasks/net8.0/</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="$(BuildTaskOutputDir)Microsoft.CodeAnalysis.dll"
        Condition="Exists('$(BuildTaskOutputDir)Microsoft.CodeAnalysis.dll')">
        <PackagePath>tasks/net8.0/</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="$(BuildTaskOutputDir)Microsoft.CodeAnalysis.CSharp.dll"
        Condition="Exists('$(BuildTaskOutputDir)Microsoft.CodeAnalysis.CSharp.dll')">
        <PackagePath>tasks/net8.0/</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="$(BuildTaskOutputDir)System.Collections.Immutable.dll"
        Condition="Exists('$(BuildTaskOutputDir)System.Collections.Immutable.dll')">
        <PackagePath>tasks/net8.0/</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
      <_PackageFiles Include="$(BuildTaskOutputDir)System.Reflection.Metadata.dll"
        Condition="Exists('$(BuildTaskOutputDir)System.Reflection.Metadata.dll')">
        <PackagePath>tasks/net8.0/</PackagePath>
        <BuildAction>None</BuildAction>
      </_PackageFiles>
    </ItemGroup>
  </Target>
</Project>