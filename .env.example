# Optional local-only publish (Trusted Publishing is preferred via release.yml).
# Copy to .env and fill in:
#   cp .env.example .env
#
# Never commit .env

# Classic nuget.org API key (local script only)
NUGET_API_KEY=

# Optional overrides for scripts/publish-nuget.sh
# PACKAGE_ID=MinimalSerializers.Json
# PACKAGE_VERSION=1.0.0
# NUGET_SOURCE=https://api.nuget.org/v3/index.json
# CONFIGURATION=Release
