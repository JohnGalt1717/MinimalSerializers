<Project>
  <PropertyGroup>
    <Authors>James Hancock</Authors>
    <Company>James Hancock</Company>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) James Hancock</Copyright>
    <Product>MinimalSerializers</Product>
    <PackageProjectUrl>https://github.com/JohnGalt1717/MinimalSerializers</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JohnGalt1717/MinimalSerializers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>json;system.text.json;source-generator;datacontract;aot;serialization</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <VersionPrefix>1.0.3</VersionPrefix>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
